# Copie ce fichier en .env et remplis-le TOI-MÊME (ne le partage jamais)
PORT=3000
# Adresse publique du service (sans / final) : site d'achat + API
PUBLIC_URL=https://mazone.com
# Supabase > Project Settings > Database > Connection string (URI, mode "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Moneroo > Developers > API Keys  (commence par test_ en mode test)
MONEROO_SECRET_KEY=
# Moneroo > Developers > Webhooks > secret de signature
MONEROO_WEBHOOK_SECRET=
# Stock : nombre de tickets prêts par forfait que le serveur maintient sur le routeur
STOCK_TARGET=60
# Mot de passe du tableau de bord /admin.html (10 caracteres minimum)
ADMIN_PASSWORD=
# Commission Moneroo de ton contrat, en %
COMMISSION_PERCENT=2
