# Copie ce fichier en .env et remplis-le TOI-MÊME (ne le partage jamais)
PORT=3000
# Adresse publique du service (sans / final). Inutile sur Render tant que tu utilises xxx.onrender.com
PUBLIC_URL=https://mazone.com
# Supabase > Connect > Session pooler (URI), avec ton mot de passe de base de données
DATABASE_URL=postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# CinetPay > ton espace marchand > clés API
#   sk_test_...  = bac à sable (tests)      sk_live_... = production (vrais paiements)
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Stock : nombre de tickets prêts par forfait que le serveur maintient sur le routeur
STOCK_TARGET=60
# Mot de passe du tableau de bord /admin.html (10 caractères minimum)
ADMIN_PASSWORD=
# Commission CinetPay de ton contrat, en %
COMMISSION_PERCENT=3
